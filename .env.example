# ==============================================================================
# ENVIRONMENT CONFIGURATION - DISKOMINFO KOTA YOGYAKARTA
# ==============================================================================

# Application Environment (development / testing / production)
APP_ENV=development
APP_PORT=8080
ENABLE_TEST_AUTH=true

# Database (PostgreSQL 16+)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=app_db

# In-Memory Cache (Redis 7+)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_BUCKET_NAME=app-bucket
MINIO_USE_SSL=false

# Identity & Access Management (SSO JSS Keycloak)
KEYCLOAK_SERVER_URL=https://sso.jogjakota.go.id
KEYCLOAK_REALM=jogjakota
KEYCLOAK_CLIENT_ID=app-client
KEYCLOAK_CLIENT_SECRET=client-secret-key

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
